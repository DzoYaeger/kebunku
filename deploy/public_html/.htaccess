<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    # ── Prioritaskan index.html (frontend SPA) sebagai halaman utama ──
    <IfModule mod_dir.c>
        DirectoryIndex index.html index.php
    </IfModule>

    RewriteEngine On

    # ── Teruskan header Authorization (wajib untuk token Sanctum Bearer) ──
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # ── Paksa HTTPS (aman dari redirect loop di balik proxy SSL) ──
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # ── 1) Request /api/* → Laravel (index.php) ──
    RewriteCond %{REQUEST_URI} ^/api/ [NC]
    RewriteRule ^ index.php [L]

    # ── 2) Jika file fisik ada (assets, sw.js, manifest, dll) → sajikan langsung ──
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ── 3) Selain itu → SPA frontend (index.html) ──
    RewriteRule ^ index.html [L]
</IfModule>

# ── Caching aset statis (opsional, mempercepat PWA) ──
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    # Service worker & HTML jangan di-cache lama agar update cepat
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "sw\.js$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
